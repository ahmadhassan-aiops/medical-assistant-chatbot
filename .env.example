# ── Copy this file to ".env" and fill in your key ─────────────────────────
# You only need the key for the provider you plan to use.

# Groq — free tier, get a key at https://console.groq.com/keys
GROQ_API_KEY=

# xAI Grok — https://console.x.ai
XAI_API_KEY=

# Optional: any other OpenAI-compatible endpoint (OpenAI, OpenRouter, local, …)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
